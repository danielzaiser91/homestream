# Caddy auto-HTTPS reverse proxy.
# Caddy fetches and renews Let's Encrypt certificates automatically as long as
# WATCH_DOMAIN / REQUEST_DOMAIN point (via DNS) at this server's public IP and
# ports 80 + 443 are reachable from the internet.

{
	email {$ACME_EMAIL}
}

# Jellyfin — the actual player/library ("watch.yourdomain")
{$WATCH_DOMAIN} {
	reverse_proxy jellyfin:8096
	encode gzip
	header {
		# Sensible security headers; harmless for a media server.
		Strict-Transport-Security "max-age=31536000;"
		X-Content-Type-Options "nosniff"
	}
}

# Jellyseerr — the friendly "browse & request a title" UI ("request.yourdomain")
{$REQUEST_DOMAIN} {
	reverse_proxy jellyseerr:5055
	encode gzip
}

# FileBrowser — drag-and-drop uploads into the media library ("files.yourdomain").
# Defaults to files.localhost (unreachable from outside) if FILES_DOMAIN is unset.
{$FILES_DOMAIN:files.localhost} {
	reverse_proxy filebrowser:80
	encode gzip
}

# Radarr admin UI ("radarr.yourdomain"). Only defined if RADARR_DOMAIN is set;
# defaults to radarr.localhost (unreachable from outside) otherwise. Radarr has
# its OWN login (Forms auth) — make sure it is enabled before exposing this, or
# the admin panel is wide open. Used e.g. by Jellyseerr's "Open in Radarr" link.
{$RADARR_DOMAIN:radarr.localhost} {
	reverse_proxy radarr:7878
	encode gzip
}
