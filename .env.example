# Copy this file to `.env` and fill in your values, then: docker compose up -d
# NEVER commit the real .env (it is gitignored).

# Timezone (e.g. Europe/Berlin, America/New_York)
TZ=Europe/Berlin

# --- Domains -----------------------------------------------------------------
# Auto-HTTPS needs real DNS names pointing at your server's public IP.
# Easiest free option: a DuckDNS subdomain (https://www.duckdns.org) or any
# domain you own. Create two names (or two sub-subdomains):
WATCH_DOMAIN=watch.example.duckdns.org      # Jellyfin  (where people watch)
REQUEST_DOMAIN=request.example.duckdns.org  # Jellyseerr (where people request)

# Email used by Let's Encrypt for certificate expiry notices.
ACME_EMAIL=you@example.com

# --- Media -------------------------------------------------------------------
# Absolute path on the HOST to your media library. Jellyfin mounts it read-only.
# On Oracle/VPS this is typically /srv/media. Organize as:
#   /srv/media/movies/<Title (Year)>/<Title (Year)>.mkv
#   /srv/media/shows/<Show>/Season 01/<Show> - S01E01.mkv
MEDIA_PATH=/srv/media
